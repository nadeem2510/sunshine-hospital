# Sunshine Hospital - GMB Automation .env
# Copy this file to .env and fill in your values

# === CLAUDE AI (Required) ===
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# === GOOGLE MY BUSINESS (Required) ===
# Run: python gmb_automation.py --get-locations  to get your Location ID
GMB_LOCATION_ID=accounts/YOUR_ACCOUNT_ID/locations/YOUR_LOCATION_ID

# === OPTIONAL ===
# Set to true to skip publishing and only preview posts
GMB_DRY_RUN=false
